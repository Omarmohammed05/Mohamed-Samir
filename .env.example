# ─── Auth Mode ───────────────────────────────────────────
# 'mock'  = local-only auth with predefined users, no Supabase needed (default)
# 'supabase' = use Supabase Auth (requires the Supabase vars below)
AUTH_MODE=mock

# JWT secret used to sign mock-auth session cookies (required in mock mode)
# Generate one: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# ─── Supabase (required only when AUTH_MODE=supabase) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — used ONLY by scripts (create-user, reset-password), never in client bundles
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Google Sheets Mode ─────────────────────────────────
# 'mock'  = in-memory store with sample data, no credentials needed
# 'excel' = use a local Excel file (data/entries.xlsx), no credentials needed (default)
# 'real'  = use the Google Sheets API (requires the Google vars below)
SHEETS_MODE=excel

# Path to the Excel file (only used when SHEETS_MODE=excel)
EXCEL_FILE_PATH=data/entries.xlsx

# ─── Google Sheets (required only when SHEETS_MODE=real) ─
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# Paste the private key including \n escape sequences, wrapped in quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# ─── App Config ─────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Daily Entries
